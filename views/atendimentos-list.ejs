<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <title>Atendimentos</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="container mt-4">
  <h2>Atendimentos</h2>

  <table class="table table-striped">
    <thead>
      <tr>
        <th>ID</th>
        <th>Animal</th>
        <th>Dono</th>
        <th>Serviço</th>
        <th>Veterinário</th>
        <th>Especialidade</th>
        <th>Data</th>
        <th>Horário</th>
        <th>Forma</th>
        <th>Valor</th>
      </tr>
    </thead>
    <tbody>
      <% if (atendimentos && atendimentos.length) { %>
        <% atendimentos.forEach(a => { %>
          <tr>
            <td><%= a.id_atendimento %></td>
            <td><%= a.animal %></td>
            <td><%= a.dono %></td>
            <td><%= a.servico %></td>
            <td><%= a.veterinario %></td>
            <td><%= a.especialidade %></td>
            <td><%= a.data_atendimento %></td>
            <td><%= a.horario %></td>
            <td><%= a.forma_pagamento || '-' %></td>
            <td><%= a.valor != null ? a.valor : '-' %></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="8">Nenhum atendimento encontrado.</td></tr>
      <% } %>
    </tbody>
  </table>

  <a href="/atendimentos/agendar" class="btn btn-primary">Agendar novo atendimento</a>
</body>
</html>
