<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Animais - Clínica Veterinária</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f7fa;
        }

        .navbar {
            background-color: #0b3c5d;
        }

        .navbar-brand,
        .nav-link {
            color: #fff !important;
            font-weight: 500;
        }

        .btn-add {
            background-color: #ff2f92;
            border-color: #ff2f92;
            color: #fff;
        }

        .btn-add:hover {
            background-color: #e02680;
            border-color: #e02680;
        }

        table {
            background-color: white;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        thead {
            background-color: #0b3c5d;
            color: white;
        }

        tbody tr:hover {
            background-color: #f0f0f0;
        }

        .btn-sm {
            padding: 4px 8px;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">
            🐾 Clínica Veterinária
        </a>

        <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="/donos">Donos</a></li>
                <li class="nav-item"><a class="nav-link" href="/animais">Animais</a></li>
                <li class="nav-item"><a class="nav-link" href="/veterinarios">Veterinários</a></li>
                <li class="nav-item"><a class="nav-link" href="/servicos">Serviços</a></li>
            </ul>
        </div>
    </div>
</nav>

<!-- CONTEÚDO -->
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Animais Cadastrados</h2>
        <a href="/animais/add" class="btn btn-add">
            <i class="bi bi-plus-circle"></i> Novo Animal
        </a>
    </div>

    <% if (animais.length === 0) { %>
        <div class="alert alert-info text-center" role="alert">
            Nenhum animal cadastrado. <a href="/animais/add">Cadastre um novo animal</a>
        </div>
    <% } else { %>
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th><i class="bi bi-paw"></i> Animal</th>
                        <th>Idade</th>
                        <th>Espécie</th>
                        <th>Raça</th>
                        <th>Dono</th>
                        <th>Veterinário</th>
                        <th>Especialidade</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    <% animais.forEach(a => { %>
                        <tr>
                            <td><strong><%= a.nome %></strong></td>
                            <td><%= a.idade %> anos</td>
                            <td><%= a.especie %></td>
                            <td><%= a.raca %></td>
                            <td><%= a.dono_nome || '—' %></td>
                            <td><%= a.veterinario_nome || '—' %></td>
                            <td><%= a.veterinario_especialidade || '—' %></td>
                            <td>
                                <a href="/animais/edit/<%= a.id %>" class="btn btn-sm btn-primary">
                                    <i class="bi bi-pencil"></i> Editar
                                </a>
                                <a href="/animais/delete/<%= a.id %>" 
                                   onclick="return confirm('Deseja excluir este animal?')" 
                                   class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Excluir
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</div>

<!-- FOOTER -->
<%- include('partials/footer') %>
</body>
</html>

