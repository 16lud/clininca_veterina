<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Animais</title>
<style>
body { background:#e3ecec; font-family:Arial; padding:30px }
h1 { color:rgb(29, 28, 28); text-align:center }
table { width:100%; background:white; border-collapse:collapse; margin-top:20px }
th { background:#3a9d9a; color:white; padding:10px }
td { padding:10px; text-align:center }
tr:hover { background:#e0f2f1 }
a.btn {
    background:#3a9d9a;
    color:white;
    padding:6px 10px;
    text-decoration:none;
    border-radius:4px;
    margin:0 3px;
}
a.delete { background:#e53935 }
a.edit { background:#1e88e5 }
</style>
</head>
<body>

<h1>Animais Cadastrados</h1>
<a class="btn" href="/animais/add">+ Novo Animal</a>

<table>
<tr>
<th>Animal</th>
<th>Idade</th>
<th>Espécie</th>
<th>Raça</th>
<th>Dono</th>
<th>Veterinário</th>
<th>Ações</th>
</tr>

<% animais.forEach(a => { %>
<tr>
<td><%= a.nome %></td>
<td><%= a.idade %></td>
<td><%= a.especie %></td>
<td><%= a.raca %></td>
<td><%= a.dono_nome || '—' %></td>
<td><%= a.veterinario_nome || '—' %></td>
<td>
     <a class="btn edit" href="/animais/edit/<%= a.id %>">Editar</a>
     <a class="btn delete"
         href="/animais/delete/<%= a.id %>"
       onclick="return confirm('Deseja excluir este animal?')">
       Excluir
    </a>
</td>
</tr>
<% }) %>

</table>
</body>
</html>

