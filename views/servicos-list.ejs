<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Serviços - Clínica Veterinária</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background-color: #f5f7fa;
        }

        .navbar {
            background-color: #0b3c5d;
        }

        .navbar-brand,
        .nav-link {
            color: #fff !important;
            font-weight: 500;
        }

        .card-servico {
            border: none;
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            transition: transform 0.2s;
        }

        .card-servico:hover {
            transform: scale(1.03);
        }

        .preco {
            font-size: 1.2rem;
            font-weight: bold;
            color: #0b3c5d;
        }
    </style>
</head>
<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">
            🐾 Clínica Veterinária
        </a>

        <div class="collapse navbar-collapse">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/donos">Donos</a>
                </li>
            
                <li class="nav-item">
                    <a class="nav-link" href="/animais">Animais</a>
                </li>
            
                <li class="nav-item">
                    <a class="nav-link" href="/veterinarios">Veterinários</a>
                </li>
            
                <li class="nav-item">
                    <a class="nav-link" href="/atendimentos/agendar">
                        Atendimentos
                    </a>
                </li>
            </ul>
            
            </ul>
        </div>
    </div>
</nav>

<!-- CONTEÚDO -->
<div class="container">
    <h2 class="mb-4 text-center">Serviços Disponíveis</h2>

    <div class="row g-4">
        <% if (servicos.length === 0) { %>
            <div class="col-12 text-center">
                <p class="text-muted">Nenhum serviço cadastrado.</p>
            </div>
        <% } %>

        <% servicos.forEach(servico => { %>
            <div class="col-md-4">
                <div class="card card-servico">
                    <div class="card-body text-center">
                        <i class="bi bi-heart-pulse fs-1 text-primary"></i>

                        <h5 class="card-title mt-3">
                            <%= servico.nome_servico %>
                        </h5>

                        <p class="card-text">
                            <%= servico.descricao %>
                        </p>

                        <p class="preco">
                            R$ <%= servico.preco_base %>
                        </p>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</div>

<!-- FOOTER -->
<%- include('partials/footer') %>

</body>
</html>