<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Confirmação de Pagamento</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root {
      --primary-color: #0d6efd;
      --success-color: #198754;
      --warning-color: #ffc107;
      --danger-color: #dc3545;
    }

    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .container-pagamento {
      background: white;
      border-radius: 15px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
      padding: 40px;
      max-width: 600px;
      width: 100%;
    }

    .header-pagamento {
      text-align: center;
      margin-bottom: 35px;
    }

    .header-pagamento h1 {
      color: #333;
      font-weight: 700;
      margin-bottom: 10px;
      font-size: 28px;
    }

    .header-pagamento p {
      color: #666;
      font-size: 16px;
    }

    .resumo-atendimento {
      background: #f8f9fa;
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 30px;
      border-left: 4px solid var(--primary-color);
    }

    .resumo-item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      padding-bottom: 12px;
      border-bottom: 1px solid #e0e0e0;
    }

    .resumo-item:last-child {
      margin-bottom: 0;
      border-bottom: none;
      padding-bottom: 0;
    }

    .resumo-label {
      color: #666;
      font-weight: 600;
      font-size: 14px;
    }

    .resumo-valor {
      color: #333;
      font-weight: 700;
      font-size: 14px;
    }

    .valor-total-box {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border-radius: 10px;
      padding: 20px;
      margin-bottom: 30px;
      text-align: center;
    }

    .valor-total-box .label {
      font-size: 14px;
      opacity: 0.9;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .valor-total-box .valor {
      font-size: 36px;
      font-weight: 700;
      margin: 10px 0 0 0;
    }

    .form-group-custom {
      margin-bottom: 25px;
    }

    .form-group-custom label {
      font-weight: 600;
      color: #333;
      margin-bottom: 10px;
      display: block;
    }

    .form-control, .form-select {
      border: 2px solid #e0e0e0;
      border-radius: 8px;
      padding: 12px 15px;
      font-size: 15px;
      transition: all 0.3s ease;
    }

    .form-control:focus, .form-select:focus {
      border-color: var(--primary-color);
      box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
    }

    .form-select {
      cursor: pointer;
      background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
      background-repeat: no-repeat;
      background-position: right 10px center;
      background-size: 18px;
      padding-right: 38px;
      appearance: none;
    }

    .form-control:read-only {
      background-color: #f8f9fa;
      border-color: #e0e0e0;
      color: #666;
      cursor: not-allowed;
      font-weight: 600;
    }

    .info-box {
      background: #e7f3ff;
      border: 1px solid #bee5eb;
      border-radius: 8px;
      padding: 12px 15px;
      margin-bottom: 20px;
      color: #004085;
      font-size: 14px;
      font-weight: 500;
    }

    .info-box i {
      margin-right: 8px;
    }

    /* Buttons */
    .buttons-container {
      display: flex;
      gap: 12px;
      margin-top: 30px;
      justify-content: space-between;
    }

    .btn-custom {
      padding: 12px 30px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 16px;
      border: none;
      cursor: pointer;
      transition: all 0.3s ease;
      flex: 1;
    }

    .btn-success-custom {
      background: var(--success-color);
      color: white;
    }

    .btn-success-custom:hover {
      background: #157347;
      transform: translateY(-2px);
      box-shadow: 0 5px 15px rgba(25, 135, 84, 0.3);
    }

    .btn-secondary-custom {
      background: #e0e0e0;
      color: #333;
    }

    .btn-secondary-custom:hover {
      background: #d0d0d0;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .container-pagamento {
        padding: 25px;
      }

      .header-pagamento h1 {
        font-size: 24px;
      }

      .valor-total-box .valor {
        font-size: 28px;
      }

      .buttons-container {
        flex-direction: column;
      }

      .btn-custom {
        width: 100%;
      }
    }
  </style>
</head>
<body>

<div class="container-pagamento">
  <div class="header-pagamento">
    <h1>💳 Confirmação de Pagamento</h1>
    <p>Escolha a forma de pagamento para finalizar o agendamento</p>
  </div>

  <!-- Resumo do Atendimento -->
  <div class="resumo-atendimento">
    <h5 style="margin-bottom: 15px; color: #333;">📋 Resumo do Agendamento</h5>
    <div class="resumo-item">
      <span class="resumo-label">🐾 Animal:</span>
      <span class="resumo-valor"><%= atendimento.nome_animal %></span>
    </div>
    <div class="resumo-item">
      <span class="resumo-label">👤 Dono:</span>
      <span class="resumo-valor"><%= atendimento.nome_dono %></span>
    </div>
    <div class="resumo-item">
      <span class="resumo-label">🏥 Serviço:</span>
      <span class="resumo-valor"><%= atendimento.nome_servico %></span>
    </div>
    <div class="resumo-item">
      <span class="resumo-label">👨‍⚕️ Veterinário:</span>
      <span class="resumo-valor"><%= atendimento.nome_vet %></span>
    </div>
    <div class="resumo-item">
      <span class="resumo-label">📅 Data:</span>
      <span class="resumo-valor"><%= atendimento.data_atendimento %></span>
    </div>
    <div class="resumo-item">
      <span class="resumo-label">⏰ Horário:</span>
      <span class="resumo-valor"><%= atendimento.horario %></span>
    </div>
  </div>

  <!-- Valor Total -->
  <div class="valor-total-box">
    <div class="label">Valor Total a Pagar</div>
    <div class="valor">R$ <span id="valor-display"><%= valor ? valor.toFixed(2) : '0.00' %></span></div>
  </div>

  <!-- Aviso -->
  <div class="info-box">
    ℹ️ O valor foi calculado automaticamente baseado no serviço selecionado.
  </div>

  <!-- Formulário de Pagamento -->
  <form action="/atendimentos/finalizar" method="POST">
    <!-- Hidden fields com os IDs para salvar no banco -->
    <input type="hidden" name="id_animal" value="<%= atendimento.id_animal %>">
    <input type="hidden" name="id_servico" value="<%= atendimento.id_servico %>">
    <input type="hidden" name="id_vet" value="<%= atendimento.id_vet %>">
    <input type="hidden" name="data_atendimento" value="<%= atendimento.data_atendimento %>">
    <input type="hidden" name="horario" value="<%= atendimento.horario %>">
    <input type="hidden" name="observacoes" value="<%= atendimento.observacoes || '' %>">
    <input type="hidden" name="valor" value="<%= valor || 0 %>">>

    <div class="form-group-custom">
      <label for="forma_pagamento">Forma de Pagamento</label>
      <select id="forma_pagamento" name="forma_pagamento" class="form-select" required>
        <option value="">-- Selecione uma forma de pagamento --</option>
        <option value="PIX">🔵 PIX (Transferência instantânea)</option>
        <option value="Cartão">💳 Cartão de Crédito/Débito</option>
        <option value="Dinheiro">💵 Dinheiro (Na clínica)</option>
      </select>
    </div>

    <!-- Buttons -->
    <div class="buttons-container">
      <a href="javascript:history.back()" class="btn-custom btn-secondary-custom">
        ← Voltar
      </a>
      <button type="submit" class="btn-custom btn-success-custom">
        ✓ Confirmar Pagamento
      </button>
    </div>
  </form>
</div>



</body>
</html> 